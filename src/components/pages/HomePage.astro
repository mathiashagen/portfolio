---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, getUi } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getFeaturedProject } from "../../lib/projects";
import ProjectCard from "../ProjectCard.astro";

const t = getUi(Astro.currentLocale);
const lang = getLang(Astro.currentLocale);
const featuredProject = await getFeaturedProject(lang);
---

<BaseLayout title={t.home.title} description={t.home.description}>
	<section>
		<p class="prompt">$ whoami</p>
		<h1>{t.home.name}</h1>
		<p class="tagline">{t.home.tagline}</p>
		<p>{t.home.intro}</p>
	</section>
	{featuredProject && (
	<section>
		<h2>{t.home.featured}</h2>
		<ProjectCard project={featuredProject} headingLevel={3} />
		<p class="more">
			<a href={getRelativeLocaleUrl(lang, "projects")}>
				{t.home.allProjects} <span aria-hidden="true">→</span>
			</a>
		</p>
	</section>
)}
</BaseLayout>

<style>
section + section {
	margin-top: var(--space-5);
}
.more {
	margin-top: var(--space-3);
	font-family: var(--font-mono);
}
.prompt,
.tagline {
	font-family: var(--font-mono);
	color: var(--color-muted);
}
h1::after {
	content: "_" / "";
	color: var(--color-accent);
}
@media (prefers-reduced-motion: no-preference) {
	h1::after {
		animation: blink 1s steps(1) infinite;
	}
}
@keyframes blink {
	50% {
		opacity: 0;
	}
}
</style>
