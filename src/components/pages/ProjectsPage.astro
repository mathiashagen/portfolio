---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, getUi } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjectSlug, getProjects } from "../../lib/projects";

const t = getUi(Astro.currentLocale);
const lang = getLang(Astro.currentLocale);
const projects = await getProjects(lang);
---

<BaseLayout title={t.projects.title} description={t.projects.description}>
	<h1>{t.projects.heading}</h1>
	<ul>
		{projects.map((project) => (
	<li>
		<h2><a href={getRelativeLocaleUrl(lang, `projects/${getProjectSlug(project)}`)}>{project.data.title}</a></h2>
		<p>{project.data.summary}</p>
		<p>{project.data.tech.join(", ")}</p>
		{project.data.repo && (
			<p>
				<a href={project.data.repo} rel="noopener noreferrer">
					{t.projects.repo}
				</a>
			</p>
		)}
		{project.data.demo && (
			<p>
				<a href={project.data.demo} rel="noopener noreferrer">
					{t.projects.demo}
				</a>
			</p>
		)}
	</li>
))}
	</ul>
</BaseLayout>
