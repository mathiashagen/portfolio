---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, getUi } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = getUi(lang);

const currentPage = Astro.url.pathname;
const links: { href: string; label: string }[] = [
	{ href: getRelativeLocaleUrl(lang, "/"), label: t.nav.home },
	{ href: getRelativeLocaleUrl(lang, "/about"), label: t.nav.about },
	{ href: getRelativeLocaleUrl(lang, "/projects"), label: t.nav.projects },
	{ href: getRelativeLocaleUrl(lang, "/contact"), label: t.nav.contact },
];
---

<nav>
	{links.map((link) => (
	<a
		href={link.href}
		aria-current={currentPage === link.href ? "page" : undefined}
	>
		{link.label}
	</a>
))}
</nav>

<style>
nav {
	display: flex;
	flex-wrap: wrap;
	column-gap: var(--space-2);
}
a[aria-current="page"] {
	font-weight: bold;
	color: var(--color-accent);
}
a {
	min-height: var(--tap-size);
	display: inline-flex;
	align-items: center;
	padding-inline: var(--space-1);
	font-family: var(--font-mono);
	color: var(--color-text);
}
a[aria-current="page"]::before {
	content: ">" / "";
	margin-right: 0.5ch;
}
</style>
