---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang } from "../i18n/ui";
import { getProjectSlug } from "../lib/projects";
import TechTags from "./TechTags.astro";

interface Props {
	project: CollectionEntry<"projects">;
	headingLevel?: 2 | 3;
}
const { project, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const lang = getLang(Astro.currentLocale);
---

<article>
	<Image
		src={project.data.cover}
		alt={project.data.coverAlt}
		sizes="(max-width: 800px) 100vw, 800px"
		widths={[400, 800, 1200]}
		quality={90}
	/>
	<Heading>
		<a href={getRelativeLocaleUrl(lang, `projects/${getProjectSlug(project)}`)}
			>{project.data.title}</a
		>
	</Heading>
	<p>{project.data.summary}</p>
	<TechTags tech={project.data.tech} />
</article>

<style>
article {
	position: relative;
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: 8px;
	padding: var(--space-4);
	transition: border-color 0.15s;
}
article:hover {
	border-color: var(--color-accent);
}
/* The title link covers the whole card, so the image is clickable too, while
   there is still only one link to tab to and read out. */
a::after {
	content: "";
	position: absolute;
	inset: 0;
	border-radius: inherit;
}
a:focus-visible {
	outline: none;
}
article:has(a:focus-visible) {
	outline: 2px solid var(--color-accent);
	outline-offset: 2px;
}
img {
	display: block;
	width: 100%;
	aspect-ratio: 16 / 10;
	object-fit: cover;
	object-position: top;
	border: 1px solid var(--color-border);
	border-radius: 4px;
}
</style>
